  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-logo">
            <span class="logo-icon">S</span>
            <span class="logo-text">Souk<span class="logo-accent">EnLigne</span></span>
          </div>
          <p class="footer-desc"><%= settings.store_description || 'Votre marché en ligne au Tchad' %></p>
        </div>
        <div class="footer-col">
          <h4>Navigation</h4>
          <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/boutique">Boutique</a></li>
            <li><a href="/compte">Mon compte</a></li>
            <li><a href="/panier">Mon panier</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Catégories</h4>
          <ul>
            <% categories.slice(0, 6).forEach(cat => { %>
            <li><a href="/boutique?categorie=<%= cat.slug %>"><%= cat.name %></a></li>
            <% }); %>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <ul>
            <li><%= settings.store_address || "N'Djaména, Tchad" %></li>
            <li><a href="tel:<%= settings.store_phone || '' %>"><%= settings.store_phone || '' %></a></li>
            <li><a href="mailto:<%= settings.store_email || '' %>"><%= settings.store_email || '' %></a></li>
            <li>
              <a href="<%= whatsappLink(whatsappNumber, 'Bonjour SoukEnLigne!') %>" target="_blank" rel="noopener" class="footer-wa">
                Commander sur WhatsApp
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <%= storeName %>. Tous droits réservés.</p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
