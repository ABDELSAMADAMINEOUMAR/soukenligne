<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof metaTitle !== 'undefined' && metaTitle ? metaTitle : (pageTitle ? pageTitle + ' — ' + storeName : storeName + ' — ' + (settings.store_tagline || '')) %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (settings.meta_description || '') %>">
  <link rel="icon" href="/images/baron-technology-icon.jpg" type="image/jpeg">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= typeof metaTitle !== 'undefined' && metaTitle ? metaTitle : (pageTitle ? pageTitle + ' — ' + storeName : storeName) %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (settings.meta_description || '') %>">
  <% if (typeof ogImage !== 'undefined' && ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <meta property="og:site_name" content="<%= storeName %>">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Top bar -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <span class="top-bar-text"><%= settings.store_tagline || 'Votre satisfaction est notre priorité' %></span>
      <div class="top-bar-links">
        <a href="<%= whatsappLink(whatsappNumber, 'Bonjour, je visite votre boutique Baron Technology.') %>" target="_blank" rel="noopener" class="top-bar-wa">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.612.616l4.584-1.453A11.949 11.949 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.359 0-4.542-.809-6.271-2.164l-.438-.35-3.172 1.006 1.04-3.1-.383-.461A9.956 9.956 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Main header -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <img src="/images/baron-technology-logo.jpg" alt="Baron Technology" class="logo-img">
      </a>

      <div class="search-bar">
        <form action="/boutique" method="GET" class="search-form" style="position: relative;">
          <input type="text" name="q" placeholder="Rechercher un produit..." value="<%= typeof query !== 'undefined' ? query : '' %>" class="search-input" autocomplete="off" oninput="handleLiveSearch(this)">
          <button type="submit" class="search-btn" aria-label="Rechercher">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </button>
          <div class="live-search-results"></div>
        </form>
      </div>

      <div class="header-right" style="display: flex; align-items: center; gap: 1.25rem; margin-left: auto;">
        <nav class="header-actions">
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin" class="header-action" title="Administration">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            <span class="header-action-label">Admin</span>
          </a>
          <% } %>
          <a href="/compte" class="header-action" title="Mon compte">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span class="header-action-label"><%= currentUser ? currentUser.full_name.split(' ')[0] : 'Compte' %></span>
          </a>
          <a href="/panier" class="header-action cart-action" title="Mon panier" style="position: relative;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span class="cart-badge" id="cart-badge"><%= cartCount %></span>
            <span class="header-action-label">Panier</span>
          </a>
        </nav>

        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu" style="display: flex; align-items: center; justify-content: center; padding: 0; margin: 0;">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile search -->
    <div class="mobile-search container">
      <form action="/boutique" method="GET" class="search-form" style="position: relative;">
        <input type="text" name="q" placeholder="Rechercher..." value="<%= typeof query !== 'undefined' ? query : '' %>" class="search-input" autocomplete="off" oninput="handleLiveSearch(this)">
        <button type="submit" class="search-btn" aria-label="Rechercher">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
        <div class="live-search-results"></div>
      </form>
    </div>

    <!-- Category nav -->
    <nav class="category-nav" id="category-nav">
      <div class="container">
        <ul class="category-list">
          <li><a href="/boutique" class="cat-link">Tout voir</a></li>
          <% categories.forEach(cat => { %>
          <li><a href="/boutique?categorie=<%= cat.slug %>" class="cat-link"><%= cat.name %></a></li>
          <% }); %>
        </ul>
      </div>
    </nav>
  </header>

  <!-- Mobile Sidebar Menu -->
  <div class="mobile-sidebar-overlay" id="mobile-sidebar-overlay"></div>
  <div class="mobile-sidebar" id="mobile-sidebar">
    <div class="mobile-sidebar-header">
      <h3 style="margin: 0; font-size: 1.2rem; color: var(--primary);">Menu</h3>
      <button class="close-sidebar-btn" id="close-sidebar-btn" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
    </div>
    <ul class="mobile-sidebar-links">
      <li><a href="/">🏠 Accueil</a></li>
      <li><a href="/boutique">🛍️ Tout voir</a></li>
      <li style="margin-top: 1rem; border-top: 1px solid #eee; padding-top: 1rem; font-size: 0.85rem; color: #666; text-transform: uppercase;">Catégories</li>
      <% categories.forEach(cat => { %>
        <li><a href="/boutique?categorie=<%= cat.slug %>"><%= cat.name %></a></li>
      <% }); %>
      <li style="margin-top: 1rem; border-top: 1px solid #eee; padding-top: 1rem; font-size: 0.85rem; color: #666; text-transform: uppercase;">Mon Compte</li>
      <li><a href="/compte">👤 Profil</a></li>
      <li><a href="/panier">🛒 Mon Panier (<%= cartCount %>)</a></li>
    </ul>
  </div>

  <main class="main-content">
