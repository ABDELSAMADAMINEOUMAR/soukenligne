<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> — Admin Baron Technology</title>
  <link rel="icon" href="/images/baron-technology-icon.jpg" type="image/jpeg">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
  <!-- Mobile Sidebar Overlay for Admin -->
  <div class="mobile-sidebar-overlay" id="admin-sidebar-overlay" style="z-index: 10;"></div>

  <aside class="admin-sidebar" id="admin-sidebar">
    <div class="admin-sidebar-header">
      <a href="/admin" class="admin-logo">
        <img src="/images/baron-technology-logo-white.jpg" alt="Baron Technology" class="admin-logo-img">
      </a>
    </div>
    <nav class="admin-nav">
      <a href="/admin" class="admin-nav-link <%= pageTitle === 'Tableau de bord' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Tableau de bord
      </a>
      <a href="/admin/produits" class="admin-nav-link <%= pageTitle === 'Produits' || pageTitle.includes('produit') ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        Produits
      </a>
      <a href="/admin/categories" class="admin-nav-link <%= pageTitle === 'Catégories' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        Catégories
      </a>
      <a href="/admin/commandes" class="admin-nav-link <%= pageTitle === 'Commandes' || pageTitle.includes('Commande') ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Commandes
      </a>
      <a href="/admin/clients" class="admin-nav-link <%= pageTitle === 'Clients' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Clients
      </a>
      <a href="/admin/parametres" class="admin-nav-link <%= pageTitle === 'Paramètres' ? 'active' : '' %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Paramètres
      </a>
      <div class="admin-nav-divider"></div>
      <a href="/" class="admin-nav-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Voir la boutique
      </a>
      <a href="/compte/deconnexion" class="admin-nav-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Déconnexion
      </a>
    </nav>
  </aside>

  <div class="admin-main">
    <header class="admin-topbar">
      <button class="admin-menu-btn" id="admin-menu-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
      <h1 class="admin-page-title"><%= pageTitle %></h1>
      <div class="admin-topbar-right" style="display: flex; align-items: center; gap: 1rem;">
        <!-- Notification Bell -->
        <div id="notif-wrapper" style="position: relative;">
          <button id="notif-bell" onclick="toggleNotifDropdown()" style="background: none; border: none; cursor: pointer; position: relative; padding: 6px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <span id="notif-badge" style="display: none; position: absolute; top: 0; right: 0; background: #ef4444; color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 11px; font-weight: 700; line-height: 18px; text-align: center;">0</span>
          </button>
          <!-- Dropdown -->
          <div id="notif-dropdown" style="display: none; position: absolute; right: 0; top: 110%; width: 340px; background: white; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.15); z-index: 1100; overflow: hidden;">
            <div style="padding: 1rem 1.25rem; border-bottom: 1px solid #e2e8f0; font-weight: 600; color: #1e293b; display: flex; justify-content: space-between; align-items: center;">
              <span>🔔 Notifications</span>
              <span id="notif-dropdown-count" style="background: #ef4444; color: white; border-radius: 999px; padding: 2px 8px; font-size: 12px;">0</span>
            </div>
            <div id="notif-list" style="max-height: 300px; overflow-y: auto;">
              <p style="padding: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.875rem;">Aucune commande en attente</p>
            </div>
            <a href="/admin/commandes?status=pending" style="display: block; text-align: center; padding: 0.75rem; background: #f8fafc; color: var(--primary); font-weight: 600; text-decoration: none; border-top: 1px solid #e2e8f0; font-size: 0.875rem;">Voir toutes les commandes</a>
          </div>
        </div>
        <span class="admin-user"><%= currentUser ? currentUser.full_name : 'Admin' %></span>
      </div>
    </header>
    <div class="admin-content">

<style>
  @keyframes bellShake {
    0% { transform: rotate(0); }
    15% { transform: rotate(14deg); }
    30% { transform: rotate(-14deg); }
    45% { transform: rotate(10deg); }
    60% { transform: rotate(-10deg); }
    75% { transform: rotate(4deg); }
    90% { transform: rotate(-2deg); }
    100% { transform: rotate(0); }
  }
  .bell-animate svg { animation: bellShake 0.6s ease-in-out; }
  #notif-list .notif-item {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.75rem 1.25rem; border-bottom: 1px solid #f1f5f9;
    text-decoration: none; color: inherit; transition: background 0.15s;
  }
  #notif-list .notif-item:hover { background: #f8fafc; }
  .notif-icon { width: 36px; height: 36px; border-radius: 50%; background: #fef3c7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 16px; }
  .notif-text { flex: 1; }
  .notif-text strong { display: block; font-size: 0.8125rem; color: #1e293b; }
  .notif-text span { font-size: 0.75rem; color: #64748b; }
  
  @media (max-width: 480px) {
    #notif-dropdown {
      position: fixed !important;
      top: 70px !important;
      right: 15px !important;
      left: 15px !important;
      width: auto !important;
    }
  }
</style>

<script>
(function() {
  let lastKnownCount = -1; // -1 means first load, don't alert

  function formatPrice(n) {
    return new Intl.NumberFormat('fr-FR').format(n) + ' FCFA';
  }

  function fetchNotifications() {
    fetch('/admin/api/notifications')
      .then(r => r.json())
      .then(data => {
        const badge = document.getElementById('notif-badge');
        const dropdownCount = document.getElementById('notif-dropdown-count');
        const list = document.getElementById('notif-list');
        const bell = document.getElementById('notif-bell');

        // Update badge
        if (data.pendingCount > 0) {
          badge.textContent = data.pendingCount > 99 ? '99+' : data.pendingCount;
          badge.style.display = 'block';
          dropdownCount.textContent = data.pendingCount;
        } else {
          badge.style.display = 'none';
          dropdownCount.textContent = '0';
        }

        // Alert on NEW orders (not on first load)
        if (lastKnownCount >= 0 && data.pendingCount > lastKnownCount) {
          bell.classList.add('bell-animate');
          setTimeout(() => bell.classList.remove('bell-animate'), 700);

          // Browser notification if permission granted
          if (Notification.permission === 'granted') {
            new Notification('🛒 Nouvelle commande !', {
              body: 'Vous avez ' + data.pendingCount + ' commande(s) en attente.',
              icon: '/images/baron-technology-icon.jpg'
            });
          }
        }
        lastKnownCount = data.pendingCount;

        // Build dropdown list
        if (data.recentPending.length > 0) {
          list.innerHTML = data.recentPending.map(o => {
            const isCancelled = o.status === 'cancelled';
            const icon = isCancelled ? '❌' : '📦';
            const bgClass = isCancelled ? 'background: #fee2e2;' : 'background: #fef3c7;';
            const titleColor = isCancelled ? 'color: #ef4444;' : 'color: #1e293b;';
            const statusLabel = isCancelled ? ' (Annulée par client)' : '';
            return '<a class="notif-item" href="/admin/commandes/' + o.id + '">' +
              '<div class="notif-icon" style="' + bgClass + '">' + icon + '</div>' +
              '<div class="notif-text">' +
                '<strong style="' + titleColor + '">' + o.order_number + statusLabel + '</strong>' +
                '<span>' + (o.customer_name || 'Client') + ' — ' + formatPrice(o.total) + '</span>' +
              '</div>' +
            '</a>';
          }).join('');
        } else {
          list.innerHTML = '<p style="padding: 1.5rem; text-align: center; color: #94a3b8; font-size: 0.875rem;">Aucune commande en attente ✓</p>';
        }
      })
      .catch(() => {}); // Silently fail
  }

  // Toggle dropdown
  window.toggleNotifDropdown = function() {
    const dd = document.getElementById('notif-dropdown');
    dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
  };

  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    const wrapper = document.getElementById('notif-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
      document.getElementById('notif-dropdown').style.display = 'none';
    }
  });

  // Ask for browser notification permission
  if ('Notification' in window && Notification.permission === 'default') {
    Notification.requestPermission();
  }

  // Initial fetch + poll every 15 seconds
  fetchNotifications();
  setInterval(fetchNotifications, 15000);
})();
</script>
