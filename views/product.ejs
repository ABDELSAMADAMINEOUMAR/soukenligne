<%- include('partials/header') %>

<section class="section product-page">
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Accueil</a>
      <span>›</span>
      <a href="/boutique">Boutique</a>
      <% if (product.category_name) { %>
      <span>›</span>
      <a href="/boutique?categorie=<%= product.category_slug %>"><%= product.category_name %></a>
      <% } %>
      <span>›</span>
      <span><%= product.name %></span>
    </nav>

    <div class="product-detail">
      <!-- Images -->
      <div class="product-gallery">
        <div class="product-main-image" id="main-image-container">
          <% if (images.length > 0) { %>
          <img src="<%= images[0].image_path %>" alt="<%= product.name %>" id="main-product-image">
          <% } else { %>
          <div class="product-card-placeholder" style="height:400px;display:flex;align-items:center;justify-content:center;background:var(--gray-100);border-radius:12px">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <% } %>
        </div>
        <% if (images.length > 1) { %>
        <div class="product-thumbs">
          <% images.forEach((img, i) => { %>
          <button type="button" class="product-thumb <%= i === 0 ? 'active' : '' %>" data-image="<%= img.image_path %>">
            <img src="<%= img.image_path %>" alt="<%= product.name %> image <%= i + 1 %>">
          </button>
          <% }); %>
        </div>
        <% } %>
      </div>

      <!-- Info -->
      <div class="product-info">
        <% if (product.brand) { %>
        <span class="product-brand"><%= product.brand %></span>
        <% } %>

        <h1 class="product-title"><%= product.name %></h1>

        <div class="product-pricing">
          <% if (product.discount_price) { %>
          <span class="product-price-current"><%= formatPrice(product.discount_price) %></span>
          <span class="product-price-original"><%= formatPrice(product.price) %></span>
          <span class="product-discount">-<%= Math.round((1 - product.discount_price / product.price) * 100) %>%</span>
          <% } else { %>
          <span class="product-price-current"><%= formatPrice(product.price) %></span>
          <% } %>
        </div>

        <div class="product-availability">
          <% if (product.is_available && product.stock_quantity > 0) { %>
          <span class="avail-badge avail-in">✓ En stock</span>
          <% if (product.stock_quantity <= 5) { %>
          <span class="avail-low">Plus que <%= product.stock_quantity %> en stock !</span>
          <% } %>
          <% } else { %>
          <span class="avail-badge avail-out">Rupture de stock</span>
          <% } %>
        </div>

        <% if (product.short_description) { %>
        <p class="product-short-desc"><%= product.short_description %></p>
        <% } %>

        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
        <div class="product-actions" style="margin-top: 1.5rem;">
          <a href="/admin/produits/modifier/<%= product.id %>" class="btn btn-outline btn-lg btn-block" style="border-color: var(--primary); color: var(--primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 0.5rem;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Modifier ce produit
          </a>
        </div>
        <% } else { %>
          <% if (product.is_available && product.stock_quantity > 0) { %>
          <div class="product-actions">
            <div class="quantity-selector">
              <button type="button" class="qty-btn" data-delta="-1">−</button>
              <input type="number" value="1" min="1" max="<%= product.stock_quantity %>" id="qty-input" class="qty-input">
              <button type="button" class="qty-btn" data-delta="1">+</button>
            </div>
            <button type="button" class="btn btn-primary btn-lg btn-block" id="order-now-btn" aria-expanded="false" aria-controls="quick-order-panel">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              Commander maintenant
            </button>
          </div>

          <div class="quick-order" id="quick-order-panel" hidden>
            <h2 class="quick-order-title">Vos informations de livraison</h2>
            <form action="/commande/direct/<%= product.slug %>" method="POST" id="quick-order-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="quantity" id="quick-order-qty" value="1">
              <div class="form-group">
                <label for="qo-name">Nom complet *</label>
                <input type="text" id="qo-name" name="delivery_full_name" class="form-input" required maxlength="200" autocomplete="name" placeholder="ex: Mahamat Ali">
              </div>
              <div class="form-group">
                <label for="qo-phone">Téléphone *</label>
                <input type="tel" id="qo-phone" name="delivery_phone" class="form-input" required maxlength="30" autocomplete="tel" placeholder="+235 ...">
              </div>
              <div class="form-group">
                <label for="qo-city">Ville / Zone *</label>
                <% if (zones.length > 0) { %>
                <select id="qo-city" name="delivery_zone_id" class="form-input" required>
                  <option value="" disabled selected>Sélectionnez une zone</option>
                  <% zones.forEach(zone => { %><option value="<%= zone.id %>"><%= zone.name %></option><% }); %>
                </select>
                <% } else { %>
                <input type="text" id="qo-city" name="delivery_city" class="form-input" required maxlength="100" placeholder="N'Djaména">
                <% } %>
              </div>
              <div class="form-group">
                <label for="qo-neighborhood">Quartier *</label>
                <input type="text" id="qo-neighborhood" name="delivery_neighborhood" class="form-input" required maxlength="200">
              </div>
              <div class="form-group">
                <label for="qo-address">Adresse / point de repère</label>
                <input type="text" id="qo-address" name="delivery_address" class="form-input" maxlength="500" placeholder="Rue, près de la mosquée...">
              </div>
              <p class="quick-order-note">Paiement à la livraison · Livraison gratuite</p>
              <button type="submit" class="btn btn-primary btn-lg btn-block">Confirmer la commande</button>
            </form>

            <div class="direct-secondary-actions">
              <form action="/panier/ajouter" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="product_id" value="<%= product.id %>">
                <input type="hidden" name="quantity" id="quick-cart-qty" value="1">
                <input type="hidden" name="redirect" value="panier">
                <button type="submit" class="btn btn-outline btn-lg btn-block">Ajouter au panier</button>
              </form>
              <a href="/boutique" class="btn btn-outline btn-lg btn-block">Continuer mes achats</a>
            </div>
          </div>
          <% } %>
        <% } %>

        <div class="product-meta-info">
          <div class="meta-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            <span>Livraison disponible partout au Tchad</span>
          </div>
          <div class="meta-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            <span>Paiement à la livraison</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Description -->
    <% if (product.description) { %>
    <div class="product-description">
      <h2>Description</h2>
      <div class="desc-content"><%= product.description %></div>
    </div>
    <% } %>

    <!-- Related products -->
    <% if (related.length > 0) { %>
    <div class="related-products">
      <h2 class="section-title">Produits similaires</h2>
      <div class="products-grid">
        <% related.forEach(product => { %>
          <%- include('partials/product-card', { product }) %>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<script nonce="<%= nonce %>">
document.addEventListener('DOMContentLoaded', () => {
  // Gallery image click handler
  document.querySelectorAll('.product-thumb').forEach(thumb => {
    thumb.addEventListener('click', function() {
      const src = this.getAttribute('data-image');
      const mainImg = document.getElementById('main-product-image');
      if (mainImg && src) {
        mainImg.src = src;
        document.querySelectorAll('.product-thumb').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
      }
    });
  });

  // Quantity button click handlers
  document.querySelectorAll('.qty-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const delta = parseInt(this.getAttribute('data-delta'), 10);
      const input = document.getElementById('qty-input');
      if (input && !isNaN(delta)) {
        const val = parseInt(input.value, 10) + delta;
        const max = parseInt(input.max, 10);
        if (val >= 1 && val <= max) input.value = val;
        syncQty();
      }
    });
  });

  // Quick order panel: reveal the info form immediately on click
  const qtyInput = document.getElementById('qty-input');
  function syncQty() {
    if (!qtyInput) return;
    const q = Math.min(Math.max(1, parseInt(qtyInput.value, 10) || 1), parseInt(qtyInput.max, 10) || 1);
    ['quick-order-qty', 'quick-cart-qty'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = q;
    });
  }
  if (qtyInput) qtyInput.addEventListener('input', syncQty);

  const orderBtn = document.getElementById('order-now-btn');
  const panel = document.getElementById('quick-order-panel');
  if (orderBtn && panel) {
    orderBtn.addEventListener('click', () => {
      syncQty();
      panel.hidden = false;
      orderBtn.setAttribute('aria-expanded', 'true');
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const first = document.getElementById('qo-name');
      if (first) setTimeout(() => first.focus({ preventScroll: true }), 300);
    });
  }
});
</script>

<%- include('partials/footer') %>
