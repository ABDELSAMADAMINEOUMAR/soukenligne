<%- include('partials/header') %>

<!-- Hero banner -->
<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">Achetez en ligne,<br><span class="hero-accent">payez à la livraison</span></h1>
      <p class="hero-sub">Découvrez les meilleurs produits au Tchad. Commandez en toute simplicité et recevez votre commande chez vous.</p>
      <div class="hero-actions">
        <a href="/boutique" class="btn btn-primary btn-lg">Voir la boutique</a>
        <a href="<%= whatsappLink(whatsappNumber, 'Bonjour, je voudrais passer une commande.') %>" target="_blank" class="btn btn-wa btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.612.616l4.584-1.453A11.949 11.949 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
          Commander sur WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Trust indicators -->
<section class="trust-bar">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-item">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        <div><strong>Livraison rapide</strong><span>Partout au Tchad</span></div>
      </div>
      <div class="trust-item">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        <div><strong>Paiement à la livraison</strong><span>Aucun paiement en ligne requis</span></div>
      </div>
      <div class="trust-item">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <div><strong>Support WhatsApp</strong><span>Nous répondons rapidement</span></div>
      </div>
      <div class="trust-item">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div><strong>Achat sécurisé</strong><span>Satisfaction garantie</span></div>
      </div>
    </div>
  </div>
</section>

<!-- Categories -->
<% if (categories.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Nos catégories</h2>
      <a href="/boutique" class="section-link">Tout voir</a>
    </div>
    <div class="categories-grid">
      <% categories.forEach(cat => { %>
      <a href="/boutique?categorie=<%= cat.slug %>" class="category-card">
        <div class="category-card-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3><%= cat.name %></h3>
        <span class="category-count"><%= cat.product_count %> produit<%= cat.product_count > 1 ? 's' : '' %></span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Featured products -->
<% if (featured.length > 0) { %>
<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Produits en vedette</h2>
      <a href="/boutique" class="section-link">Voir tout</a>
    </div>
    <div class="products-grid">
      <% featured.forEach(product => { %>
        <%- include('partials/product-card', { product }) %>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Special offers -->
<% if (discounted.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">🔥 Offres spéciales</h2>
      <a href="/boutique" class="section-link">Voir tout</a>
    </div>
    <div class="products-grid">
      <% discounted.forEach(product => { %>
        <%- include('partials/product-card', { product }) %>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Latest products -->
<% if (latest.length > 0) { %>
<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Nouveaux produits</h2>
      <a href="/boutique" class="section-link">Voir tout</a>
    </div>
    <div class="products-grid">
      <% latest.forEach(product => { %>
        <%- include('partials/product-card', { product }) %>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- CTA -->
<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>Besoin d'aide pour commander ?</h2>
      <p>Contactez-nous directement sur WhatsApp. Nous sommes là pour vous aider à trouver le produit parfait et organiser la livraison.</p>
      <a href="<%= whatsappLink(whatsappNumber, 'Bonjour, je voudrais de l\'aide pour passer une commande sur SoukEnLigne.') %>" target="_blank" class="btn btn-wa btn-lg">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.612.616l4.584-1.453A11.949 11.949 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
        Discuter sur WhatsApp
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
