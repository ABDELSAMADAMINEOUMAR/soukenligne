<%- include('../partials/header') %>

<main class="container" style="max-width: 500px; margin-top: 4rem; margin-bottom: 4rem;">
  <div class="card" style="padding: 2rem;">
    <h1 style="text-align: center; margin-bottom: 1.5rem;">Réinitialiser le mot de passe</h1>
    
    <% if (error) { %>
      <div class="alert alert-danger" style="margin-bottom: 1rem;"><%= error %></div>
    <% } %>

    <form action="/compte/reinitialiser-mot-de-passe" method="POST">
      <input type="hidden" name="token" value="<%= token %>">
      
      <div class="form-group">
        <label for="password">Nouveau mot de passe (min 12 caractères)</label>
        <input type="password" id="password" name="password" required class="form-input" minlength="12">
      </div>
      
      <div class="form-group">
        <label for="password_confirm">Confirmer le nouveau mot de passe</label>
        <input type="password" id="password_confirm" name="password_confirm" required class="form-input" minlength="12">
      </div>
      
      <button type="submit" class="btn btn-primary btn-block">Réinitialiser le mot de passe</button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
