<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <h1 class="page-title">Mon compte</h1>

    <div class="account-layout">
      <div class="account-sidebar">
        <div class="account-user">
          <div class="account-avatar"><%= user.full_name.charAt(0).toUpperCase() %></div>
          <div class="account-user-info">
            <strong><%= user.full_name %></strong>
            <span class="text-muted"><%= user.email %></span>
          </div>
        </div>
        <nav class="account-nav">
          <a href="#orders" class="active" onclick="switchTab('orders-section', this); return false;">Mes commandes</a>
          <a href="#profile" onclick="switchTab('profile-section', this); return false;">Mon profil</a>
          <a href="/compte/deconnexion">Déconnexion</a>
        </nav>
      </div>

      <div class="account-main">
        <!-- Orders -->
        <div class="account-section" id="orders-section">
          <h2>Mes commandes</h2>
          <% if (orders.length === 0) { %>
          <div class="empty-state-small">
            <p>Vous n'avez pas encore passé de commande.</p>
            <a href="/boutique" class="btn btn-primary">Découvrir nos produits</a>
          </div>
          <% } else { %>
          <div class="orders-list">
            <% orders.forEach(order => { %>
            <a href="/compte/commande/<%= order.order_number %>" class="order-card">
              <div class="order-card-header">
                <span class="order-number"><%= order.order_number %></span>
                <span class="status-badge <%= statusClass(order.status) %>"><%= statusLabel(order.status) %></span>
              </div>
              <div class="order-card-body">
                <span><%= formatPrice(order.total) %></span>
                <span class="text-muted"><%= new Date(order.created_at).toLocaleDateString('fr-FR') %></span>
              </div>
            </a>
            <% }); %>
          </div>
          <% } %>
        </div>

        <!-- Profile -->
        <div class="account-section" id="profile-section" style="display: none;">
          <h2>Mon profil</h2>
          <form action="/compte/profil" method="POST" class="profile-form">
            <div class="form-row">
              <div class="form-group">
                <label>Nom complet</label>
                <input type="text" name="full_name" value="<%= user.full_name %>" class="form-input" required>
              </div>
              <div class="form-group">
                <label>Email</label>
                <input type="email" value="<%= user.email %>" class="form-input" disabled>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Téléphone</label>
                <input type="tel" name="phone" value="<%= user.phone || '' %>" class="form-input">
              </div>
              <div class="form-group">
                <label>WhatsApp</label>
                <input type="tel" name="whatsapp" value="<%= user.whatsapp || '' %>" class="form-input">
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function switchTab(tabId, linkElement) {
    // Hide all sections
    document.getElementById('orders-section').style.display = 'none';
    document.getElementById('profile-section').style.display = 'none';
    
    // Show target section
    document.getElementById(tabId).style.display = 'block';
    
    // Update active class on links
    const links = document.querySelectorAll('.account-nav a');
    links.forEach(link => {
      if (link.getAttribute('href').startsWith('#')) {
        link.classList.remove('active');
      }
    });
    linkElement.classList.add('active');
  }

  // Check URL hash on load to switch to profile if needed (e.g., after save)
  if (window.location.hash === '#profile') {
    const profileLink = document.querySelector('a[href="#profile"]');
    if (profileLink) switchTab('profile-section', profileLink);
  }
</script>

<%- include('../partials/footer') %>
