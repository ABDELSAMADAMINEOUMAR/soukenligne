<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <h1 class="page-title">Mon panier</h1>

    <% if (cart.length === 0) { %>
    <div class="empty-state">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      <h3>Votre panier est vide</h3>
      <p>Découvrez nos produits et ajoutez vos articles favoris.</p>
      <a href="/boutique" class="btn btn-primary">Voir la boutique</a>
    </div>
    <% } else { %>
    <div class="cart-layout">
      <div class="cart-items">
        <% cart.forEach(item => { %>
        <div class="cart-item">
          <a href="/produit/<%= item.slug %>" class="cart-item-img">
            <% if (item.image) { %>
            <img src="<%= item.image %>" alt="<%= item.name %>">
            <% } else { %>
            <div class="cart-item-placeholder"></div>
            <% } %>
          </a>
          <div class="cart-item-info">
            <a href="/produit/<%= item.slug %>" class="cart-item-name"><%= item.name %></a>
            <div class="cart-item-price">
              <span class="price-current"><%= formatPrice(item.price) %></span>
              <% if (item.discount_price) { %>
              <span class="price-original"><%= formatPrice(item.original_price) %></span>
              <% } %>
            </div>
          </div>
          <div class="cart-item-actions">
            <form action="/panier/modifier" method="POST" class="cart-qty-form">
              <input type="hidden" name="product_id" value="<%= item.product_id %>">
              <div class="quantity-selector quantity-sm">
                <button type="button" class="qty-btn" onclick="this.parentNode.querySelector('input[name=quantity]').stepDown();this.closest('form').submit()">−</button>
                <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.max_quantity %>" class="qty-input" onchange="this.closest('form').submit()">
                <button type="button" class="qty-btn" onclick="this.parentNode.querySelector('input[name=quantity]').stepUp();this.closest('form').submit()">+</button>
              </div>
            </form>
            <form action="/panier/supprimer" method="POST">
              <input type="hidden" name="product_id" value="<%= item.product_id %>">
              <button type="submit" class="cart-remove-btn" title="Supprimer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </form>
          </div>
          <div class="cart-item-subtotal">
            <strong><%= formatPrice(item.price * item.quantity) %></strong>
          </div>
        </div>
        <% }); %>
      </div>

      <div class="cart-summary">
        <h3>Récapitulatif</h3>
        <div class="summary-row">
          <span>Sous-total</span>
          <span><%= formatPrice(cartTotal) %></span>
        </div>
        <div class="summary-row">
          <span>Livraison</span>
          <span class="text-muted">Calculée à la commande</span>
        </div>
        <div class="summary-row summary-total">
          <span>Total estimé</span>
          <span><%= formatPrice(cartTotal) %></span>
        </div>
        <a href="/commande" class="btn btn-primary btn-lg btn-block">Passer la commande</a>
        <a href="/boutique" class="btn btn-outline btn-block">Continuer vos achats</a>
      </div>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
