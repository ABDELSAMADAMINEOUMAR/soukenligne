<%- include('../partials/admin-header') %>

<div class="admin-card">
  <% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form id="product-form" action="/admin/produits/<%= product && product.id ? 'modifier/' + product.id : 'ajouter' %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row">
      <div class="form-group" style="flex:2">
        <label>Nom du produit *</label>
        <input type="text" name="name" required class="form-input" value="<%= product ? product.name : '' %>">
      </div>
      <div class="form-group">
        <label>Catégorie</label>
        <select name="category_id" class="form-input">
          <option value="">— Aucune —</option>
          <% categories.forEach(c => { %>
          <option value="<%= c.id %>" <%= product && product.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label>Description courte</label>
      <input type="text" name="short_description" class="form-input" value="<%= product ? (product.short_description || '') : '' %>" maxlength="200">
    </div>

    <div class="form-group">
      <label>Description complète</label>
      <textarea name="description" rows="5" class="form-input"><%= product ? (product.description || '') : '' %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Prix (FCFA) *</label>
        <input type="number" name="price" required class="form-input" min="0" value="<%= product ? product.price : '' %>">
      </div>
      <div class="form-group">
        <label>Prix promo (FCFA)</label>
        <input type="number" name="discount_price" class="form-input" min="0" value="<%= product && product.discount_price ? product.discount_price : '' %>">
      </div>
      <div class="form-group">
        <label>Stock</label>
        <input type="number" name="stock_quantity" class="form-input" min="0" value="<%= product ? (product.stock_quantity || 0) : 0 %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Marque</label>
        <input type="text" name="brand" class="form-input" value="<%= product ? (product.brand || '') : '' %>">
      </div>
      <div class="form-group">
        <label>SKU</label>
        <input type="text" name="sku" class="form-input" value="<%= product ? (product.sku || '') : '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="is_available" value="1" <%= !product || product.is_available ? 'checked' : '' %>>
          Disponible
        </label>
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="is_featured" value="1" <%= product && product.is_featured ? 'checked' : '' %>>
          Produit en vedette
        </label>
      </div>
    </div>

    <div class="form-group">
      <label>Images du produit</label>
      <input type="file" id="image-upload-input" multiple accept=".jpg,.jpeg,.png,.webp,.gif" class="form-input">
      <span class="form-help" id="upload-help">Formats : JPG, PNG, WebP. Max 5 Mo par image. Maximum 10 images.</span>
    </div>

    <% if (product && product.images && product.images.length > 0) { %>
    <div class="existing-images">
      <label>Images actuelles</label>
      <div class="image-grid">
        <% product.images.forEach(img => { %>
        <div class="image-item">
          <img src="<%= img.image_path %>" alt="">
          <form action="/admin/produits/supprimer-image/<%= img.id %>" method="POST" style="position:absolute;top:4px;right:4px" class="delete-img-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="img-delete-btn" title="Supprimer">×</button>
          </form>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <details class="form-details">
      <summary>SEO (optionnel)</summary>
      <div class="form-group">
        <label>Meta titre</label>
        <input type="text" name="meta_title" class="form-input" value="<%= product ? (product.meta_title || '') : '' %>">
      </div>
      <div class="form-group">
        <label>Meta description</label>
        <textarea name="meta_description" rows="2" class="form-input"><%= product ? (product.meta_description || '') : '' %></textarea>
      </div>
    </details>

    <div class="form-actions">
      <a href="/admin/produits" class="btn btn-outline">Annuler</a>
      <button type="submit" id="submit-btn" class="btn btn-primary"><%= product && product.id ? 'Enregistrer' : 'Ajouter le produit' %></button>
    </div>
  </form>
</div>

<script nonce="<%= nonce %>">
document.querySelectorAll('.delete-img-form').forEach(function(form) {
  form.addEventListener('submit', function(e) {
    if (!confirm('Êtes-vous sûr de vouloir supprimer cette image ?')) {
      e.preventDefault();
    }
  });
});

const form = document.getElementById('product-form');
const fileInput = document.getElementById('image-upload-input');
const submitBtn = document.getElementById('submit-btn');
const helpText = document.getElementById('upload-help');

form.addEventListener('submit', async function(e) {
  const files = fileInput.files;
  if (!files || files.length === 0) {
    return; // allow normal submission
  }
  
  if (files.length > 10) {
    e.preventDefault();
    alert('Vous ne pouvez sélectionner que 10 images maximum.');
    return;
  }
  
  for (let i = 0; i < files.length; i++) {
    if (files[i].size > 5 * 1024 * 1024) {
      e.preventDefault();
      alert('Le fichier ' + files[i].name + ' dépasse la limite de 5 Mo.');
      return;
    }
  }

  e.preventDefault();
  
  const originalText = submitBtn.textContent;
  submitBtn.textContent = 'Envoi des images en cours...';
  submitBtn.disabled = true;
  helpText.style.color = '#eab308';
  helpText.textContent = 'Création des accès sécurisés...';
  
  try {
    // 1. Get signed URLs
    const tokenRes = await fetch('/admin/api/upload-tokens', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'CSRF-Token': document.querySelector('input[name="_csrf"]').value 
      },
      body: JSON.stringify({ count: files.length })
    });
    
    if (!tokenRes.ok) {
      const errData = await tokenRes.json();
      throw new Error(errData.error || 'Erreur lors de la préparation de l\'upload');
    }
    
    const { tokens } = await tokenRes.json();
    
    // 2. Upload each file directly to Supabase
    helpText.textContent = 'Transfert des images (0/' + files.length + ')...';
    
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      const tokenData = tokens[i];
      
      const uploadRes = await fetch(tokenData.signedUrl, {
        method: 'PUT',
        body: file,
        headers: {
          'Content-Type': file.type || 'application/octet-stream'
        }
      });
      
      if (!uploadRes.ok) {
        throw new Error('Échec du transfert de ' + file.name);
      }
      
      helpText.textContent = 'Transfert des images (' + (i + 1) + '/' + files.length + ')...';
      
      // Inject hidden input for the backend
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'uploaded_images';
      hiddenInput.value = tokenData.path;
      form.appendChild(hiddenInput);
    }
    
    // 3. Remove file input so it is not sent to Express
    fileInput.remove();
    
    // 4. Submit form
    helpText.textContent = 'Enregistrement du produit...';
    form.submit();
  } catch (err) {
    console.error(err);
    alert(err.message || 'Une erreur est survenue lors de l\'upload des images.');
    submitBtn.textContent = originalText;
    submitBtn.disabled = false;
    helpText.style.color = '#ef4444';
    helpText.textContent = 'L\'upload a échoué.';
  }
});
</script>

<%- include('../partials/admin-footer') %>
