<%- include('../partials/admin-header') %>

<div class="admin-stats">
  <div class="stat-card">
    <div class="stat-value"><%= totalProducts %></div>
    <div class="stat-label">Produits</div>
  </div>
  <div class="stat-card stat-highlight">
    <div class="stat-value"><%= pendingOrders %></div>
    <div class="stat-label">Commandes en attente</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= totalOrders %></div>
    <div class="stat-label">Total commandes</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= totalCustomers %></div>
    <div class="stat-label">Clients</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= formatPrice(totalRevenue) %></div>
    <div class="stat-label">Revenus</div>
  </div>
</div>

<div class="admin-grid-2">
  <div class="admin-card">
    <h3>Commandes récentes</h3>
    <% if (recentOrders.length === 0) { %>
    <p class="text-muted">Aucune commande pour le moment.</p>
    <% } else { %>

    <!-- Desktop table -->
    <div class="table-responsive d-none-mobile">
      <table class="data-table">
        <thead><tr><th>N°</th><th>Client</th><th>Total</th><th>Statut</th><th>Date</th></tr></thead>
        <tbody>
          <% recentOrders.forEach(o => { %>
          <tr onclick="location.href='/admin/commandes/<%= o.id %>'" style="cursor:pointer">
            <td><strong><%= o.order_number %></strong></td>
            <td><%= o.customer_name %></td>
            <td><%= formatPrice(o.total) %></td>
            <td><span class="status-badge <%= statusClass(o.status) %>"><%= statusLabel(o.status) %></span></td>
            <td><%= new Date(o.created_at).toLocaleDateString('fr-FR') %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Mobile cards -->
    <div class="d-none-desktop mobile-cards">
      <% recentOrders.forEach(o => { %>
      <a href="/admin/commandes/<%= o.id %>" class="mobile-order-card">
        <div class="mobile-order-header">
          <strong><%= o.order_number %></strong>
          <span class="status-badge <%= statusClass(o.status) %>"><%= statusLabel(o.status) %></span>
        </div>
        <div class="mobile-order-body">
          <span class="mobile-order-customer"><%= o.customer_name %></span>
          <span class="mobile-order-total"><%= formatPrice(o.total) %></span>
        </div>
        <div class="mobile-order-date"><%= new Date(o.created_at).toLocaleDateString('fr-FR') %></div>
      </a>
      <% }); %>
    </div>

    <% } %>
  </div>

  <div class="admin-card">
    <h3>Produits les plus vendus</h3>
    <% if (topProducts.length === 0) { %>
    <p class="text-muted">Aucune vente pour le moment.</p>
    <% } else { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead><tr><th>Produit</th><th>Vendus</th><th>Revenus</th></tr></thead>
        <tbody>
          <% topProducts.forEach(p => { %>
          <tr>
            <td><%= p.product_name %></td>
            <td><%= p.total_sold %></td>
            <td><%= formatPrice(p.total_revenue) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<% if (lowStock.length > 0) { %>
<div class="admin-card">
  <h3>⚠️ Stock faible</h3>
  <div class="table-responsive">
    <table class="data-table">
      <thead><tr><th>Produit</th><th>Stock</th><th>Action</th></tr></thead>
      <tbody>
        <% lowStock.forEach(p => { %>
        <tr>
          <td><%= p.name %></td>
          <td><span class="stock-low"><%= p.stock_quantity %></span></td>
          <td><a href="/admin/produits/modifier/<%= p.id %>" class="btn btn-sm btn-outline">Modifier</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('../partials/admin-footer') %>
