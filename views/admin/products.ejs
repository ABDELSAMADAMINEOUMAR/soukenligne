<%- include('../partials/admin-header') %>

<div class="admin-toolbar" style="display: flex; gap: 1rem; align-items: center;">
  <a href="/admin/produits/ajouter" class="btn btn-primary">+ Ajouter un produit</a>
  <% if (typeof filterCategory !== 'undefined' && filterCategory) { %>
    <a href="/admin/produits" class="btn btn-outline" style="border-color: #ef4444; color: #ef4444;">Effacer le filtre de catégorie ✕</a>
  <% } %>
</div>

<div class="admin-card">
  <% if (products.length === 0) { %>
  <p class="text-muted">Aucun produit. Commencez par en ajouter un.</p>
  <% } else { %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr><th>Image</th><th>Produit</th><th>Prix</th><th>Stock</th><th>Statut</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% products.filter(p => p.status !== 'deleted').forEach(p => { %>
        <tr>
          <td>
            <% if (p.image) { %>
            <img src="<%= p.image %>" alt="" class="admin-thumb">
            <% } else { %>
            <div class="admin-thumb-empty"></div>
            <% } %>
          </td>
          <td>
            <strong><%= p.name %></strong>
            <% if (p.category_name) { %><br><span class="text-muted text-sm"><%= p.category_name %></span><% } %>
            <% if (p.is_featured) { %><span class="badge-featured">★ Vedette</span><% } %>
          </td>
          <td>
            <% if (p.discount_price) { %>
            <span class="price-current"><%= formatPrice(p.discount_price) %></span><br>
            <span class="price-original text-sm"><%= formatPrice(p.price) %></span>
            <% } else { %>
            <%= formatPrice(p.price) %>
            <% } %>
          </td>
          <td><span class="<%= p.stock_quantity <= 5 ? 'stock-low' : '' %>"><%= p.stock_quantity %></span></td>
          <td><span class="status-badge <%= p.is_available ? 'status-confirmed' : 'status-cancelled' %>"><%= p.is_available ? 'Actif' : 'Inactif' %></span></td>
          <td class="actions-cell">
            <a href="/admin/produits/modifier/<%= p.id %>" class="btn btn-sm btn-outline">Modifier</a>
            <button type="button" class="btn btn-sm btn-outline quick-view-btn" title="Aperçu rapide" data-product="<%= JSON.stringify(p) %>">👁</button>
            <form action="/admin/produits/supprimer/<%= p.id %>" method="POST" style="display:inline" class="delete-product-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-danger">Suppr.</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<div id="quick-view-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1050; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
  <div style="background: white; padding: 2rem; border-radius: 12px; width: 90%; max-width: 650px; display: flex; gap: 2rem; position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    <button type="button" id="qv-close-btn" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #666;">&times;</button>
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; background: #f8fafc; border-radius: 8px; padding: 1rem;">
      <img id="qv-image" src="" alt="" style="max-width: 100%; max-height: 300px; object-fit: contain;">
    </div>
    <div style="flex: 1.5;">
      <h2 id="qv-title" style="margin-top: 0; margin-bottom: 0.25rem; font-size: 1.5rem; color: #1e293b;"></h2>
      <p id="qv-category" style="color: #64748b; font-size: 0.875rem; margin-top: 0; margin-bottom: 1rem;"></p>
      
      <div style="margin-bottom: 1.5rem;">
        <span id="qv-price" style="font-size: 1.5rem; font-weight: 700; color: var(--primary);"></span>
        <span id="qv-original-price" style="text-decoration: line-through; color: #94a3b8; margin-left: 0.5rem; font-size: 1rem;"></span>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; background: #f1f5f9; padding: 1rem; border-radius: 8px;">
        <div>
          <span style="display: block; font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 600;">Stock</span>
          <span id="qv-stock" style="font-weight: 600; color: #334155;"></span>
        </div>
        <div>
          <span style="display: block; font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 600;">Statut</span>
          <span id="qv-status" style="font-weight: 600; color: #334155;"></span>
        </div>
      </div>

      <p id="qv-desc" style="font-size: 0.875rem; color: #475569; line-height: 1.5;"></p>
    </div>
  </div>
</div>

<div id="delete-confirm-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.7); z-index: 1050; align-items: center; justify-content: center; backdrop-filter: blur(8px); opacity: 0; transition: opacity 0.3s ease;">
  <div style="background: white; padding: 2.5rem; border-radius: 16px; width: 90%; max-width: 400px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); transform: translateY(20px) scale(0.95); transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
    <div style="width: 64px; height: 64px; background: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
    </div>
    <h2 style="margin-top: 0; color: #0f172a; font-size: 1.25rem; font-weight: 700;">Supprimer ce produit ?</h2>
    <p style="color: #64748b; margin-bottom: 2rem; font-size: 0.95rem; line-height: 1.5;">Cette action est définitive et irréversible. Toutes les données liées à ce produit seront perdues.</p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
      <button type="button" id="delete-cancel-btn" class="btn btn-outline" style="flex: 1; padding: 0.75rem; border-color: #cbd5e1; color: #475569;">Annuler</button>
      <button type="button" id="delete-confirm-btn" class="btn btn-danger" style="flex: 1; padding: 0.75rem; background: #ef4444; border: none; box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.2);">Oui, supprimer</button>
    </div>
  </div>
</div>

<script nonce="<%= nonce %>">
(function() {
  function openQuickView(product) {
    document.getElementById('qv-title').textContent = product.name;
    document.getElementById('qv-category').textContent = product.category_name || 'Sans catégorie';
    
    if (product.discount_price) {
      document.getElementById('qv-price').textContent = new Intl.NumberFormat('fr-FR').format(product.discount_price) + ' FCFA';
      document.getElementById('qv-original-price').textContent = new Intl.NumberFormat('fr-FR').format(product.price) + ' FCFA';
    } else {
      document.getElementById('qv-price').textContent = new Intl.NumberFormat('fr-FR').format(product.price) + ' FCFA';
      document.getElementById('qv-original-price').textContent = '';
    }

    document.getElementById('qv-stock').textContent = product.stock_quantity;
    if (product.stock_quantity <= 5) {
      document.getElementById('qv-stock').style.color = '#ef4444';
    } else {
      document.getElementById('qv-stock').style.color = '#334155';
    }

    var statusEl = document.getElementById('qv-status');
    statusEl.textContent = product.is_available ? 'Actif' : 'Inactif';
    statusEl.style.color = product.is_available ? '#10b981' : '#ef4444';

    document.getElementById('qv-desc').textContent = product.short_description || 'Aucune description courte disponible.';
    
    var imgEl = document.getElementById('qv-image');
    if (product.image) {
      imgEl.src = product.image;
      imgEl.style.display = 'block';
    } else {
      imgEl.style.display = 'none';
    }

    document.getElementById('quick-view-modal').style.display = 'flex';
  }

  function closeQuickView() {
    document.getElementById('quick-view-modal').style.display = 'none';
  }

  // Quick View buttons
  document.querySelectorAll('.quick-view-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var product = JSON.parse(this.getAttribute('data-product'));
      openQuickView(product);
    });
  });

  document.getElementById('qv-close-btn').addEventListener('click', closeQuickView);
  document.getElementById('quick-view-modal').addEventListener('click', function(e) {
    if (e.target === this) closeQuickView();
  });

  // Custom Delete Modal Logic
  var formToSubmit = null;
  var deleteModal = document.getElementById('delete-confirm-modal');
  var modalContent = deleteModal.querySelector('div');

  function closeDeleteModal() {
    deleteModal.style.opacity = '0';
    modalContent.style.transform = 'translateY(20px) scale(0.95)';
    setTimeout(function() {
      deleteModal.style.display = 'none';
      formToSubmit = null;
    }, 300);
  }

  document.querySelectorAll('.delete-product-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      formToSubmit = this;
      deleteModal.style.display = 'flex';
      // Trigger reflow
      void deleteModal.offsetWidth;
      deleteModal.style.opacity = '1';
      modalContent.style.transform = 'translateY(0) scale(1)';
    });
  });

  document.getElementById('delete-cancel-btn').addEventListener('click', closeDeleteModal);
  
  deleteModal.addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
  });

  document.getElementById('delete-confirm-btn').addEventListener('click', function() {
    if (formToSubmit) {
      var btn = this;
      btn.textContent = 'Suppression...';
      btn.style.opacity = '0.7';
      btn.style.pointerEvents = 'none';
      formToSubmit.submit();
    }
  });
})();
</script>
<%- include('../partials/admin-footer') %>

